# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# WhatsApp Business Platform Cloud API
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=mock # Options: 'mock' | 'meta'
WHATSAPP_ACCESS_TOKEN=your-whatsapp-system-user-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-webhook-verification-token
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_API_VERSION=v20.0

# Optional AI Intent Parsing
AI_PROVIDER=none # Options: 'none' | 'gemini' | 'openai'
AI_API_KEY=your-ai-api-key

# Scheduled Background Tasks / Cron
CRON_SECRET=your-secure-cron-secret-token

# Application Base URL
APP_BASE_URL=http://localhost:3000
